{
  "version": "2.0.0",
  "tasks": [
    {
        "label": "Build Resume PDF",
        "type": "shell",
            "command": "mkdir -p dist && python3 scripts/generate_resume.py && xelatex -output-directory=dist resume.tex && find dist -type f \\( -name '*.log' -o -name '*.aux' -o -name '*.out' -o -name '*.toc' -o -name '*.synctex.gz' \\) -delete",
        "group": {
            "kind": "build",
            "isDefault": true
        },
        "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": false,
            "panel": "shared"
        }, 
        "problemMatcher": []
    },
    {
        "label": "Setup Environment",
        "type": "shell",
        "command": "bash ${workspaceFolder}/scripts/setup_environment.sh --yes",
        "options": {
            "cwd": "${workspaceFolder}",
            "env": {
                "AUTO_INSTALL": "1"
            }
        },
        "presentation": {
            "echo": true,
            "reveal": "always",
            "focus": true,
            "panel": "dedicated"
        },
        "problemMatcher": []
    }
]
}
